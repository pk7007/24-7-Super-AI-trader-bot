# Copy to .env and fill in. NEVER commit .env.
# paper (default, simulated fills) | live (real orders)
BOT_MODE=paper
# Live trading additionally requires this exact value: yes
I_UNDERSTAND_LIVE_RISK=
# Delta Exchange India API credentials (only needed for live)
DELTA_API_KEY=
DELTA_API_SECRET=
# 1 = use Delta India testnet endpoints (recommended before live)
DELTA_TESTNET=1
# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional outside heartbeat: an https ping URL (e.g. a free healthchecks.io check, 15-minute period).
# The bot pings it after every processed candle; the service alerts you when pings stop (PC off, bot dead).
HEARTBEAT_URL=
# Optional: 0 lets Windows idle-sleep while a bot runs (default 1 keeps the PC awake)
KEEP_AWAKE=1
# Optional overrides
START_EQUITY_USD=1000
USDT_INR=88
